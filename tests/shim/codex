#!/usr/bin/env bash
# shim/codex: a logging stand-in for the `codex` binary, put FIRST on PATH for the `real` scenario of
# tests/review-loop-proof.sh. The installed skill and the installed ~/.claude/config/scripts/codex-call.sh
# run untouched; the wrapper resolves `codex` through PATH, lands here, and this runs the REAL codex
# (REAL_CODEX, an absolute path) with the same arguments, replays its output and exit code unchanged,
# and appends one JSON event (see evlog.py) built from codex's own --json output.
#
# WHY a PATH shim and not a replacement wrapper: pointing the model at a different wrapper meant the
# installed skill was no longer exercised at its normal path. Nothing the skill or wrapper runs changes.
set -uo pipefail
here="$(cd "$(dirname "$0")/.." && pwd)"
real="${REAL_CODEX:?REAL_CODEX must be the absolute path of the real codex binary}"
argv=("$@")
o="$(mktemp)"; e="$(mktemp)"; pf="$(mktemp)"; so="$(mktemp)"; sin="$(mktemp)"
trap 'rm -f "$o" "$e" "$pf" "$so" "$so.err" "$so.meta" "$sin"' EXIT
# WHY stdin is saved first (r20 finding 1): codex-call.sh now sends the prompt on stdin (`-`); the real codex gets the same bytes and the log records them as the prompt.
# WHY only when the last argument is `-`: a caller that passes the prompt as an argument leaves stdin open and never closes it, so an unconditional cat hangs forever.
[[ "${*: -1}" == "-" ]] && cat > "$sin"
EVLOG="${EVLOG:-$(cd "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")/.." && pwd)/wrapper.jsonl}"
EVSTART="$(python3 -c 'import time; print(time.time())')"; export EVSTART
# Non-codex-exec calls (login status, --version) are replayed and not logged.
if [[ "${argv[0]:-}" != exec ]]; then rc=0; "$real" "${argv[@]+"${argv[@]}"}" <"$sin" >"$o" 2>"$e" || rc=$?; cat "$o"; cat "$e" >&2; exit "$rc"; fi
# WHY one merged stream for exec: codex-call.sh runs codex with `>"$out" 2>&1` and parses that single file, so a quota
# error printed only on stderr is parsed (and replayed) exactly like stdout lines; separate files changed the diagnostics (r19).
# WHY the state is captured at call START and again at the end (r13 finding 2): the reviewer judges the tree as it was when the call began. Hashing only after Codex returned let a file edited
# while the review ran inherit the earlier approval. `state` is the start state, `endstate` the state at the verdict; check-scripted.py requires both to equal the run's final tree.
# The repo is PROOF_REPO (set by review-loop-proof.sh), else the git top of the working directory.
prepo="${PROOF_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")}"
startstate="$(python3 "$here/state-hash.py" "$prepo" 2>/dev/null)"
rc=0; "$real" "${argv[@]+"${argv[@]}"}" <"$sin" >"$o" 2>&1 || rc=$?
python3 - "$o" "$rc" "$pf" "$so" "$e" "$sin" "${argv[@]}" <<'PY'
import json, sys
out, rc, pf, so, errf, sinf, *argv = sys.argv[1:]
# WHY this mirrors codex-call.sh exactly: thread id only from thread.started (never invented from the resume
# argument), turn.failed clears "done", and JSON errors plus the CLI's own non-JSON lines become the diagnostics, so a
# failed call or a quota error is logged as the wrapper would report it (r14).
tid, msg, done, errs, bad = "", "", False, [], False
raw = open(out, errors="replace").read().splitlines()
# WHY the same crash and normalization rules as codex-call.sh (r24 finding 1): a null or empty thread id, a non-object line, a non-object `error` or an agent_message with no text make the real wrapper fail,
# so the shim must record a failed call for them too (`bad`). The differential table in tests/test-checkers.sh feeds the same streams to both and requires the same accept or reject.
for line in raw:
    try: ev = json.loads(line)
    except ValueError: continue
    if not isinstance(ev, dict):
        bad = True; continue
    if ev.get("type") == "thread.started": tid = str(ev.get("thread_id") or "")
    if ev.get("type") == "turn.completed": done = True
    if ev.get("type") == "turn.failed":
        done = False
        er = ev.get("error") or {}
        if not isinstance(er, dict): bad = True; continue
        errs.append(str(er.get("message", ev)))
    if ev.get("type") == "error": errs.append(str(ev.get("message", ev)))
    if ev.get("type") == "item.completed":
        it = ev.get("item", {})
        if not isinstance(it, dict): bad = True; continue
        if it.get("type") == "agent_message":
            if "text" not in it: bad = True; continue
            msg = it["text"]
# WHY parse the subcommand: only the first non-option token after `exec` (skipping option values) is the subcommand, so a
# new call whose PROMPT is the word "resume" is not a resume (r24).
VALOPT = {"-p", "--profile", "-s", "--sandbox", "-C", "--cd", "-m", "--model", "-c", "--config", "--color", "-i", "--image", "--output-schema", "-o", "--output-last-message"}
def subcommand_and_id(args):
    i = 1
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in VALOPT else 1
    if i >= len(args) or args[i] != "resume":
        return ""
    i += 1
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in VALOPT else 1
    return args[i] if i < len(args) else ""
resume = subcommand_and_id(argv)
# WHY stdin when the prompt argument is `-`: the wrapper sends the prompt that way, so the logged prompt is what Codex really read.
open(pf, "w").write(open(sinf, errors="replace").read() if argv and argv[-1] == "-" else (argv[-1] if argv else ""))
# WHY a completed turn with no thread id is a failed call: the wrapper rejects it (r19 finding 2), so the logged exit must be 1.
# WHY any error or turn.failed event fails the call (r26): the wrapper withholds the verdict whenever errs is non-empty, before or after the completed turn; mirrored here so the logged exit matches.
ok = done and bool(msg) and rc == "0" and bool(tid) and not bad and not errs
open(so, "w").write(("THREAD_ID: %s\n%s\n" % (tid, msg)) if ok else "")
diag = ""
if not ok:
    # WHY the header only when there is something to say: the real wrapper prints just its terminal message when Codex said nothing (r18).
    said = errs + [l.rstrip() for l in raw if not l.lstrip().startswith("{")][-20:]
    diag = ("codex-call: Codex CLI said:\n" + "\n".join(said) + "\n") if said else ""
    diag += "codex-call: Codex turn did not complete (call died). Treat as UNREVIEWED.\n"
open(so + ".err", "w").write(diag)
open(so + ".meta", "w").write(json.dumps({"resume": resume, "tid": tid if ok else "", "ok": ok}))
PY
meta="$(cat "$so.meta")"; rm -f "$so.meta"
resume="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["resume"])' "$meta")"
tid="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["tid"])' "$meta")"
ok="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["ok"])' "$meta")"
# WHY 1: codex-call.sh exits 1 for every failed call whatever the CLI exit code was (r15).
logrc=0; [[ $ok == True ]] || logrc=1
# WHY provenance from the process table and the file, never from command text (r27 to r29): the parent bash of the installed
# codex-call.sh holds that script open on fd 255, so lsof names the file really being executed; its sha256 must equal the
# reviewed installed wrapper (WRAPPER_SHA256) and the run nonce (EVNONCE) must be set. A bare `codex exec`, a prompt that
# mentions codex-call.sh or an edited copy of the wrapper therefore fails and is logged as "direct", which no checker counts.
# WHY lsof with a /proc fallback: lsof is stock on macOS but often absent on Linux, where bash's script fd is a symlink under /proc.
wpath="$(lsof -a -p "$PPID" -d 255 -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
[[ -n "$wpath" ]] || wpath="$(readlink "/proc/$PPID/fd/255" 2>/dev/null || true)"
# WHY the parent's TRUE argument vector, not ps text (r30, r31): the kernel's KERN_PROCARGS2 record keeps argv boundaries and the
# executable path, so a forged argv[0] such as "bash <wrapper>" cannot pass. The parent must be exactly
# [<bash>, <absolute wrapper path>, ...] with the shell executable /bin/bash or the bash this PATH resolves, and the wrapper
# also open on fd 255 with the reviewed hash. Threat model: this proves the skill really called the installed codex-call.sh as
# opposed to a mistake or a stand-in; a same-uid adversary who can rewrite the harness itself is out of scope.
kind=direct; EV_PROV="$(python3 -I - "$wpath" "$real" "$PPID" "$(command -v bash)" <<'PY3'
import ctypes, ctypes.util, hashlib, json, os, struct, sys
wp, codex, ppid, pathbash = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
rp = os.path.realpath(wp) if wp and os.path.isfile(wp) else ""
def procargs(pid):
    # WHY /proc first, sysctl second (portability, cc11-main-r1): Linux exposes the true argv boundaries and executable in
    # /proc/<pid>/cmdline and /exe; macOS has no /proc, so KERN_PROCARGS2 is the equivalent there. Using only sysctl made the
    # whole provenance check raise on Linux, and using only /proc would fail on stock macOS. A failure of both returns
    # (None, []), which the caller treats as "not the installed wrapper" (fails closed).
    if os.path.exists("/proc/%d/cmdline" % pid):
        try:
            exe = os.readlink("/proc/%d/exe" % pid)
            av = open("/proc/%d/cmdline" % pid, "rb").read().split(b"\0")
            if av and av[-1] == b"":
                av = av[:-1]
            return exe, [x.decode(errors="replace") for x in av]
        except OSError:
            return None, []
    try:
        libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    except (OSError, TypeError):
        return None, []
    mib = (ctypes.c_int * 3)(1, 49, pid)  # CTL_KERN, KERN_PROCARGS2
    size = ctypes.c_size_t(0)
    if libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0:
        return None, []
    buf = ctypes.create_string_buffer(size.value)
    if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
        return None, []
    raw = buf.raw[:size.value]
    argc = struct.unpack("i", raw[:4])[0]
    exe, _, rest = raw[4:].partition(b"\0")
    items = rest.lstrip(b"\0").split(b"\0")[:argc]
    return exe.decode(errors="replace"), [x.decode(errors="replace") for x in items]
def runs_script(pid, script):
    exe, av = procargs(pid)
    shells = {os.path.realpath("/bin/bash"), os.path.realpath(pathbash)}
    if not exe or not script or os.path.realpath(exe) not in shells or len(av) < 2:
        return False
    return os.path.isabs(av[1]) and not av[1].startswith("-") and os.path.realpath(av[1]) == script
argv_ok = runs_script(ppid, rp)
sha = hashlib.sha256(open(rp, "rb").read()).hexdigest() if rp else ""
print(json.dumps({"nonce": os.environ.get("EVNONCE", ""), "wrapper_path": rp, "wrapper_sha256": sha, "wrapper_inode": os.stat(rp).st_ino if rp else None, "argv_ok": argv_ok, "codex": os.path.realpath(codex)}))
PY3
)"; export EV_PROV
python3 -c 'import json,os,sys; p=json.loads(os.environ["EV_PROV"]); sys.exit(0 if p["wrapper_sha256"] and p["argv_ok"] and p["wrapper_sha256"]==os.environ.get("WRAPPER_SHA256") and p["nonce"] and p["nonce"]==os.environ.get("EVNONCE") else 1)' && kind=real
# WHY the shim records the add() flag and the end state here (r9 finding 1): check-scripted.py `final --real` binds the last clean verdict to the state the run ended in and, for the tdd skills,
# to the implementation phase, exactly as the fake does. The start state was captured above, before codex ran.
impl=no; python3 "$here/check-impl.py" "$prepo/app.py" 2>/dev/null && impl=yes
# WHY audit= is recorded here, from the sandbox the call asked for (r11 finding 2): a Codex test audit runs read-only and an implementation call needs workspace-write, so check-scripted.py
# --audit can pick the latest audit ATTEMPT, including one that failed or returned no verdict, without reading its reply.
audit=yes; for a in "${argv[@]+"${argv[@]}"}"; do [[ $a == workspace-write ]] && audit=no; done
EV_META="state=$startstate endstate=$(python3 "$here/state-hash.py" "$prepo" 2>/dev/null) impl=$impl audit=$audit"; export EV_META
python3 "$here/evlog.py" "$EVLOG" "$kind" "$logrc" "$resume" "$tid" "$pf" "$so" "$so.err" -- "${argv[@]}"
cat "$o"; cat "$e" >&2
exit "$rc"
